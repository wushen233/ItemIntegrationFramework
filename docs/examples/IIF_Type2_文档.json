{
  // =========================================================================================
  // 👑 【视图层 Global】 - 定义该信息卡的骨架与UI排版
  // 这里的设定会被下方所有的 DataRules 自动继承，作为渲染的底板。
  // =========================================================================================
  "global": {
    "id": "Master_IIF_Card",      // [必填] 卡片唯一标识。IIF 靠此 ID 防止重复渲染，也是其他卡片的锚点目标
    "priority": 800,               // [选填] 排序权重。数值越小在处理队列中越靠前
    
    // [枚举] 布局模式 (displayType)
    // 0 = 原生纯文本 | 1 = 进度条模式 | 2 = 弹性多段容器 (本框架核心)
    "displayType": 2,              

    "hasBackground": false,        // [选填] 👑 默认不显示半透明底板，保持原版UI沉浸感
    "sortValueFrom": "rightBox",   // [选填] 告诉 IIF 拿哪个容器的值进行物品列表排序

    // 👑 ====================================================================================
    // 👑 【新增功能】智能相对锚点系统 (Anchor Engine) & 动态比对 (Difference)
    // ====================================================================================
    // 引擎会全局嗅探已有卡片的 text 标签 (官方原版为 $ 开头，自定义卡片为 id 或 text)
    "anchorTarget": "$rng",        // [选填] 锚点目标：例如 "$rng"(射程), "$acc"(命中率), 或自定义卡片 "Stats_VATS"
    "anchorMode": "after",         // [选填] 锚定模式: "after"(跟在下方), "before"(插在上方), "replace"(吞噬替换原版)

    "hideDifference": false,       // [新增] 是否隐藏装备对比时的红绿差异值？默认 false (C++ 自动计算差值并显示)
    "invertDiffColor": false,      // [新增] 是否反转红绿逻辑？(true=正红负绿。用于"AP消耗"这种越低越好的属性)

    // 基础排版容器：不需要的容器直接不写，引擎会自动居中或对齐
    "content": {
      "title": { 
        "text": "综合信息",       
        "highlight": false        
      },
      // 👑 智能语法糖基础：推荐保留 rightBox。若下方的 DataRules 中不显式写明容器，
      // 引擎会自动将内容全部填充至此右侧容器中。
      "rightBox": {
        "tag": "",
        "isIcon": false,

        // 💡 【核心规则】关于 "value" 的取值逻辑：
        // 1. 静态覆盖：填入普通文本（如 "完全损坏"），则无视游戏底层，强制显示该文字。
        // 2. 原名抓取：填入宏 "@GameName"，引擎会自动抓取该 FormID 在游戏底层的真实名称（例如自动读取出ANK汉化）。
        // 3. 数值提取：留空 ("")，当命中 ActorValue 或使用 DataSource 时，引擎自动提取数值并计算差值。
        "value": "",

        "state": "normal", // 可选: "normal"(默认), "bad"(红), "good"(绿), "standard"(纯白)
        "align": "right"   // 👑 决定文本在容器内的物理对齐方式: "right"(默认), "center"(居中), "left"(靠左)
      }
    }
  },

  // =========================================================================================
  // 🧠 【逻辑层 DataRules】 - 核心触发与数据抓取规则
  // 引擎自上而下遍历，C++ 底层自动推断 FormID 的真实类型 (Keyword/OMOD/AV/GLOB/WEAP 等)
  // =========================================================================================
  "DataRules": [
    
    // ---------------------------------------------------------------------------------------
    // 【模块 1：Form 大一统字典映射 (O(1) 极速匹配) + 智能单容器】
    // ---------------------------------------------------------------------------------------
    {
      "comment": "万物皆可 Form！把不同类型的 ID 混装在字典里，C++ 自动分类检索",
      "ConditionType": "Form",
      "ValuesMapping": {
        "BWS.esp|0x123": { "value": "完全损坏", "state": "bad" }, // C++ 自动识别为 Keyword
        "Tactical.esp|0x456": { "value": "战术挂载" },             // C++ 自动识别为 OMOD
        
        // 💡 针对特定武器进行定制化展示，无需 DataSource，纯 JSON 文字
        "Fallout4.esm|0x0001DACF": { "value": "激光滑膛枪", "tag": "充能" },
        "Fallout4.esm|0x000FE268": { "value": "射钉步枪", "tag": "动能", "state": "bad" },
        "Fallout4.esm|0x0014D09E": { "value": "激光喇叭枪", "tag": "散射" }
      }
    },

    // ---------------------------------------------------------------------------------------
    // 【模块 2：苛刻的组合条件拦截 (MatchType: AND)】
    // ---------------------------------------------------------------------------------------
    {
      "comment": "苛刻交集：必须同时满足数组中的所有 ID，才会触发此结果",
      "ConditionType": "Form",
      "MatchType": "AND",
      "ConditionIDs": [
        "Fallout4.esm|0x12345", 
        "Fallout4.esm|0x67890"  
      ],
      "Result": {
        "value": "战术全开",
        "state": "good"
      }
    },

    // ---------------------------------------------------------------------------------------
    // 【模块 3：ActorValue 属性直出模式 (内源数据提取)】
    // ---------------------------------------------------------------------------------------
    {
      "comment": "直接抓取武器/护甲属性里挂载的 ActorValue，引擎会自动触发双核比对产生红绿字",
      "ConditionType": "Form", 
      "ConditionIDs": [
        "DamageThresholdMod.esp|0x999" 
      ],
      "Result": {
        "tag": "DT",
        "state": "good"
      }
    },

    // ---------------------------------------------------------------------------------------
    // 【模块 4：外部活体数据源抓取 (外源提取) & 魔法拆包器】
    // ---------------------------------------------------------------------------------------
    {
      "comment": "向引擎外部系统请求数据。👑 支持 WeaponStat(物理隐藏属性) 和 OMODMagicMagnitude(魔法解包)",
      "ConditionType": "WeaponType",
      "ConditionIDs": ["Pistol"],
      "Result": {
        "tag": "VATS 消耗",            
        "state": "standard",

        // 👑 [数据源类型说明]：
        // "Form"               = 全局变量(GLOB)、活体 ActorValue。
        // "PerkRank"           = 提取技能进度 (Required/Max)。
        // "WeaponStat"         = 抓取底层物理属性 (ID填 "APCost", "Speed", "Reach")。
        // "OMODMagicMagnitude" = 安全拆解魔法加成 (ID填 "ANY" 或指定 OMOD ID)。
        "DataSource": {
          "Type": "WeaponStat",
          "ID": "APCost" 
        }
      }
    },

    // ---------------------------------------------------------------------------------------
    // 【模块 5：动态标签宏 (@GameName) 与 PerkRank 进度】
    // ---------------------------------------------------------------------------------------
    {
      "comment": "演示动态宏抓取游戏底层原名",
      "ConditionType": "Form",
      "ValuesMapping": {
        "Fallout4.esm|0x000FF995": { // 外星破坏者
          "tag": "@GameName",
          "isIcon": false,         
          "DataSource": {
            "Type": "PerkRank",            
            "ID": "Fallout4.esm|0x0004A0B6", 
            "Required": 4                  
          }
        },
        "Fallout4.esm|0x000FD11B": { // 舰炮枪
          "tag": "@GameName",
          "isIcon": true,
          "DataSource": {
            "Type": "PerkRank",
            "ID": "Fallout4.esm|0x0004A0D6", 
            "Required": 3 
          }
        }
      }
    },

    // ---------------------------------------------------------------------------------------
    // 【模块 6：显式双容器分离排版 + 局部对齐覆盖】
    // ---------------------------------------------------------------------------------------
    {
      "comment": "显式调用 leftBox 和 rightBox 进行包装，并演示局部覆盖 align",
      "ConditionType": "Form",
      "ConditionIDs": ["Fallout4.esm|0x000FF995"],
      "Result": {
        "leftBox": {
          "tag": "需求力量", 
          "value": "8.0",
          "state": "bad",
          "align": "left" 
        },
        "rightBox": {
          "tag": "武器重量",
          "value": "极重",
          "align": "center" 
        }
      }
    }
  ]
}
