{
  // =========================================================================================
  // 👑 【视图层 Global】 - 定义单行信息卡的骨架
  // 这里的设定会被下方所有的 DataRules 自动继承。
  // =========================================================================================
  "global": {
    "id": "Standard_IIF_Card",    // [必填] 卡片唯一标识。
    "priority": 800,               // [选填] 排序优先级。数值越小越靠前。

    // [关键枚举] 布局模式 (displayType)
    // 0 = 原生单行纯文本 (左侧标签 + 右侧数值)
    "displayType": 0,              

    // 👑 ====================================================================================
    // 👑 【核心功能】智能相对锚点系统 (Anchor Engine) & 动态比对 (Difference)
    // ====================================================================================
    // 引擎会根据此配置，决定卡片在整个信息列表中的物理位置
    "anchorTarget": "$rng",        // [选填] 锚点：锁定原版卡片(如 "$rng"射程)或自定义卡片ID
    "anchorMode": "after",         // [选填] 模式: "after"(下方), "before"(上方), "replace"(替换)

    "hideDifference": false,       // [新增] 是否隐藏对比差值？false 则显示如 (+5.0) 的红绿对比
    "invertDiffColor": false,      // [新增] 是否反转差值红绿逻辑？(true=正红负绿，适用于AP消耗)

    "content": {
      "title": { 
        "text": "属性名称",        // 左侧显示的文字，支持本地化标签(如 "$acc")
        "highlight": false         // 是否使用主题高亮色渲染标签
      }
    }
  },

  // =========================================================================================
  // 🧠 【逻辑层 DataRules】 - 核心触发与动态数据比对规则
  // =========================================================================================
  "DataRules": [
    
    // ---------------------------------------------------------------------------------------
    // 【模块 1：基础字典映射与文本覆盖】
    // ---------------------------------------------------------------------------------------
    {
      "comment": "简单的关键词触发，并手动指定右侧显示的文字",
      "ConditionType": "Form",
      "ValuesMapping": {
        "MyMod.esp|0x123": { "value": "已加固", "state": "good" },
        "MyMod.esp|0x456": { "value": "不稳定", "state": "bad" }
      }
    },

    // ---------------------------------------------------------------------------------------
    // 【模块 2：物理属性抓取 (WeaponStat) 与 自动差值】
    // ---------------------------------------------------------------------------------------
    {
      "comment": "抓取引擎底层的隐藏物理属性，并自动激活已装备武器的红绿差异对比",
      "ConditionType": "FormType",
      "ConditionIDs": ["Weapon"],
      "Result": {
        "state": "standard",       // 👑 使用标准白色字体 (不随主题色变色)
        "DataSource": {
          "Type": "WeaponStat",    //
          "ID": "APCost"           // 自动提取并比对 Action Point 消耗
        }
      }
    },

    // ---------------------------------------------------------------------------------------
    // 【模块 3：魔法效果拆包 (OMODMagicMagnitude)】
    // ---------------------------------------------------------------------------------------
    {
      "comment": "全自动拆解武器配件(OMOD)中挂载的魔法强度，并实时比对",
      "ConditionType": "FormType",
      "ConditionIDs": ["Weapon"],
      "Result": {
        "state": "standard",
        "DataSource": {
          "Type": "OMODMagicMagnitude", // 👑 强力拆包引擎
          "ID": "ANY"                   // 自动累计所有配件的魔法加成数值
        }
      }
    },

    // ---------------------------------------------------------------------------------------
    // 【模块 4：链式锚点定位案例 (复刻辐射76排版)】
    // ---------------------------------------------------------------------------------------
    {
      "comment": "利用锚点系统，将此卡片精准放置在原版射程卡片的正下方",
      "ConditionType": "FormType",
      "ConditionIDs": ["Weapon"],
      "anchorTarget": "$rng",      // 锚定原版“射程”
      "anchorMode": "after",       // 排在射程之后
      "Result": {
        "value": "100%",
        "tag": "VATS 精度"
      }
    },

    // ---------------------------------------------------------------------------------------
    // 【模块 5：动态标签宏 (@GameName)】
    // ---------------------------------------------------------------------------------------
    {
      "comment": "利用宏自动抓取游戏内翻译好的名称作为左侧标签",
      "ConditionType": "Form",
      "ConditionIDs": ["Fallout4.esm|0x0004A0B6"], 
      "Result": {
        "tag": "@GameName",        // 自动显示为“科学！”
        "value": "已激活",
        "state": "good"
      }
    }
  ]
}
